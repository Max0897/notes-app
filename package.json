{
  "name": "notes-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "start": "tsx server/index.ts",
    "start:prod": "node dist-server/index.js",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -b",
    "test:api": "node --test tests/api.test.mjs tests/management.test.mjs tests/teams.test.mjs tests/notifications.test.mjs",
    "test:docker": "node tests/docker-config-check.mjs",
    "test:e2e": "node tests/e2e-public.mjs",
    "lint": "oxlint",
    "preview": "vite preview --host localhost"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.18",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "linkifyjs": "4.3.2",
    "lucide-react": "^1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.4"
  }
}
